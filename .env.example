NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"

COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_TIMEOUT_MS=15000
COINBASE_RETRIES=3
SYMBOL=BTC-USD
INTERVAL=1

STARTING_BALANCE=80
TRADE_SIZE=10
BUY_FEE=0.1
SELL_FEE=0.1
STOP_LOSS=2
TAKE_PROFIT=3
PAPER_TRADING_ENABLED=true

RSI_BUY_THRESHOLD=35
AI_CONFIDENCE_THRESHOLD=80
STRATEGY_NAME=rsi-ema-ai

HISTORY_CANDLES=1000
MARKET_LOOKBACK_CANDLES=400

PREDICTION_PYTHON=python
PREDICTION_SCRIPT=python/predictor.py
PREDICTION_TIMEOUT_MS=15000

CRON_EXPRESSION=* * * * *

LOG_LEVEL=info
CORS_ORIGIN=*
API_PREFIX=/api

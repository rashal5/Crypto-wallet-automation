{
  "name": "crypto-paper-trading-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-quality cryptocurrency PAPER trading backend. Simulation only: never places real orders.",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "prestart": "prisma db push",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/wallet-math.test.ts tests/statistics.test.ts tests/strategies.test.ts tests/indicators.test.ts tests/paper-trading-engine.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push",
    "download:history": "tsx scripts/download-history.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "technicalindicators": "^3.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.13",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
